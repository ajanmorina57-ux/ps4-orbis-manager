# Copy to .env for local development. Never commit real credentials.
NODE_ENV=development
PORT=8080
WEB_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8080
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=replace-with-public-anon-key

# Supabase project settings. Only the anon key is used in the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key

# Private Cloudflare R2 bucket. These keys stay on the server.
R2_ACCOUNT_ID=replace-with-cloudflare-account-id
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_BUCKET=orbis-packages
R2_REGION=auto

# URL import workers only download from exact hostnames listed here.
# Leave empty to disable URL imports until this allowlist is reviewed.
IMPORT_ALLOWED_HOSTS=
MAX_PACKAGE_BYTES=53687091200
SIGNED_URL_TTL_SECONDS=300
